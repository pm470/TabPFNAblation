# Cluster connection details
CLUSTER_USER="your_username"
CLUSTER_HOST="uc3.scc.kit.edu"

# The destination directory on the cluster. 
# It can be a relative path (to your home directory) or an absolute path (to a workspace).
# Example for a workspace: 
# CLUSTER_DIR="/pfs/work9/workspace/scratch/your_username-nanotabpfn_data/TabPFNAblation/"
CLUSTER_DIR="TabPFNAblation/"

# Alternatively, you can override the entire remote destination string:
# REMOTE_DEST="your_username@uc3.scc.kit.edu:/pfs/work9/workspace/scratch/your_username-nanotabpfn_data/TabPFNAblation/"

# Hardware / GPU specific settings
# If you are developing locally on a machine with an AMD GPU, uncomment the 
# line below. 'uv' will automatically prioritize the ROCm PyTorch wheel 
# over the default Nvidia (CUDA) wheel on PyPI.
# (Note: Leave this commented out when running on the Nvidia cluster!)
# UV_EXTRA_INDEX_URL="https://download.pytorch.org/whl/rocm7.2"
