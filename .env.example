# Cluster connection details
CLUSTER_USER="your_username"
CLUSTER_HOST="uc3.scc.kit.edu"

# The destination directory for the code on the cluster. 
# It is recommended to use a relative path to sync code to your home directory.
CLUSTER_DIR="TabPFNAblation/"

# The workspace directory for data and results.
# This should be an absolute path pointing to a high-capacity storage location.
WORKSPACE_DIR="/pfs/work9/workspace/scratch/fr_lf453-nanotabpfn_data"

# Alternatively, you can override the entire remote destination string for rsync:
# REMOTE_DEST="your_username@uc3.scc.kit.edu:TabPFNAblation/"

# Hardware / GPU specific settings
# If you are developing locally on a machine with an AMD GPU, uncomment the 
# line below. 'uv' will automatically prioritize the ROCm PyTorch wheel 
# over the default Nvidia (CUDA) wheel on PyPI.
# (Note: Leave this commented out when running on the Nvidia cluster!)
# UV_EXTRA_INDEX_URL="https://download.pytorch.org/whl/rocm7.2"
